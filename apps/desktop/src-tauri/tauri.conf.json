{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video2Notes",
  "version": "0.2.0",
  "identifier": "com.lainelaina.video2notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video2Notes",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#E9EEEB"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/runs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/backend/": "backend/",
      "../../../samples/evidence-demo.mp4": "demo/evidence-demo.mp4",
      "../../../LICENSE": "licenses/VIDEO2NOTES_LICENSE.txt",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "shortDescription": "Evidence-first local video note workstation"
  }
}
